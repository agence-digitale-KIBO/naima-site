# Public site URL used for canonical links, Open Graph and the sitemap.
# Set the final domain before launch. Preview deployments fall back to VERCEL_URL.
NEXT_PUBLIC_SITE_URL=

# Keep false until the address, legal pages and domain are confirmed.
# true allows indexing.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Naima's own Cal.com account. Leave empty until she creates it.
# Event slugs are the public path segment after the username.
NEXT_PUBLIC_CAL_USERNAME=
NEXT_PUBLIC_CAL_EVENT_NAILS=
NEXT_PUBLIC_CAL_EVENT_LASHES=
NEXT_PUBLIC_CAL_EVENT_MAKEUP=
NEXT_PUBLIC_CAL_EVENT_LASER=
NEXT_PUBLIC_CAL_EVENT_HEAD_SPA=

# Optional contact transport. The form does not send until both are set.
# CONTACT_WEBHOOK_TOKEN stays on the server. Never prefix it with NEXT_PUBLIC_.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
